<UserControl x:Class="DeerFlow.WPF.Views.Controls.OpenSandboxControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DeerFlow.WPF.ViewModels"
             xmlns:local="clr-namespace:DeerFlow.WPF.Views.Controls"
             Background="{StaticResource BackgroundColor}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
        <StackPanel>
            <!-- 标题 -->
            <TextBlock Text="OpenSandbox 管理" FontSize="20" FontWeight="Bold"
                       Foreground="{StaticResource TextColor}" Margin="0,0,0,20"/>

            <!-- 连接配置 -->
            <Border Background="{StaticResource CardBackground}" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="连接配置" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextColor}" Margin="0,0,0,12"/>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="API Key:" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryColor}" Margin="0,0,12,8"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ApiKey}"
                                 Background="{StaticResource InputBackground}" Foreground="{StaticResource TextColor}"
                                 BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                                 Padding="8,6" Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="域名:" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryColor}" Margin="0,0,12,0"/>
                        <Grid Grid.Row="1" Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding ApiDomain}"
                                     Background="{StaticResource InputBackground}" Foreground="{StaticResource TextColor}"
                                     BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                                     Padding="8,6" Margin="0,0,8,0"/>
                            <Button Grid.Column="1" Content="配置" Command="{Binding ConfigureCommand}"
                                    Style="{StaticResource PrimaryButton}" Width="80"/>
                        </Grid>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 沙箱创建 -->
            <Border Background="{StaticResource CardBackground}" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="沙箱创建" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextColor}" Margin="0,0,0,12"/>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="镜像:" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryColor}" Margin="0,0,12,8"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SandboxImage}"
                                 Background="{StaticResource InputBackground}" Foreground="{StaticResource TextColor}"
                                 BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                                 Padding="8,6" Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="超时(秒):" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryColor}" Margin="0,0,12,0"/>
                        <Grid Grid.Row="1" Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding TimeoutSeconds}"
                                     Background="{StaticResource InputBackground}" Foreground="{StaticResource TextColor}"
                                     BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                                     Padding="8,6" Margin="0,0,8,0"/>
                            <Button Grid.Column="1" Content="创建" Command="{Binding CreateCommand}"
                                    IsEnabled="{Binding IsCreating, Converter={StaticResource InverseBooleanConverter}}"
                                    Style="{StaticResource PrimaryButton}" Width="80" Margin="0,0,8,0"/>
                            <Button Grid.Column="2" Content="销毁" Command="{Binding DestroyCommand}"
                                    IsEnabled="{Binding IsConnected}"
                                    Style="{StaticResource DangerButton}" Width="80"/>
                        </Grid>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 代码执行 -->
            <Border Background="{StaticResource CardBackground}" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="代码执行" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextColor}" Margin="0,0,0,12"/>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="语言:" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryColor}" Margin="0,0,8,0"/>
                            <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}"
                                      Background="{StaticResource InputBackground}" Foreground="{StaticResource TextColor}"
                                      BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                                      Padding="8,4" Width="120"/>
                        </StackPanel>

                        <TextBox Grid.Row="1" Text="{Binding CommandInput}"
                                 Background="{StaticResource InputBackground}" Foreground="{StaticResource TextColor}"
                                 BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                                 Padding="8,6" Margin="0,0,0,8"
                                 AcceptsReturn="True" TextWrapping="Wrap" Height="60"
                                 AcceptsTab="True"/>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0" Text="{Binding OutputText}" IsReadOnly="True"
                                     Background="{StaticResource TerminalBackground}" Foreground="{StaticResource TerminalText}"
                                     BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                                     Padding="8" FontFamily="Consolas" Height="250"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     TextWrapping="NoWrap" AcceptsReturn="True" Margin="0,0,8,0"/>

                            <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Top">
                                <Button Content="执行" Command="{Binding ExecuteCommand}"
                                        IsEnabled="{Binding IsConnected}"
                                        Style="{StaticResource PrimaryButton}" Width="80" Height="36" Margin="0,0,0,8"/>
                                <Button Content="续期" Command="{Binding RenewCommand}"
                                        IsEnabled="{Binding IsConnected}"
                                        Style="{StaticResource SecondaryButton}" Width="80" Height="36" Margin="0,0,0,8"/>
                                <Button Content="清空" Command="{Binding ClearOutputCommand}"
                                        Style="{StaticResource SecondaryButton}" Width="80" Height="36"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 状态显示 -->
            <Border Background="{StaticResource CardBackground}" CornerRadius="8" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="状态:" VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryColor}" Margin="0,0,12,0"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="10" Height="10" Margin="0,0,8,0"
                                 Fill="{Binding IsConnected, Converter={StaticResource BooleanToBrushConverter}}"/>
                        <TextBlock Text="{Binding StatusMessage}"
                                   Foreground="{StaticResource TextColor}" FontSize="13"/>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
