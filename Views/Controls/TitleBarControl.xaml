<UserControl x:Class="DeerFlow.WPF.Views.Controls.TitleBarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">

    <Grid Background="{StaticResource BackgroundColor}"
          MouseDown="OnTitleBarMouseDown">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- 返回按钮 — 首页不显示（使用 GoBackCommand 的 CanExecute 控制可见性） -->
        <Button Grid.Column="0" Content="← 返回" Width="70" Height="32"
                Foreground="{StaticResource TextSecondaryColor}"
                Background="Transparent" BorderThickness="0"
                FontSize="13" Cursor="Hand" Margin="12,0,0,0"
                Command="{Binding GoBackCommand}"
                Visibility="{Binding GoBackCommand, Converter={StaticResource CommandToVisibilityConverter}}"
                WindowChrome.IsHitTestVisibleInChrome="True"/>

        <!-- 应用标题 -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0"
                    WindowChrome.IsHitTestVisibleInChrome="True">
            <TextBlock Text="🦌" FontSize="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock Text="DeerFlow" FontSize="16" FontWeight="SemiBold" 
                       Foreground="{StaticResource TextColor}" VerticalAlignment="Center"/>
            <TextBlock Text="WPF" FontSize="16" FontWeight="Light" 
                       Foreground="{StaticResource AccentColor}" VerticalAlignment="Center" Margin="4,0,0,0"/>
        </StackPanel>

        <!-- 窗口控制按钮 -->
        <StackPanel Grid.Column="2" Orientation="Horizontal"
                    WindowChrome.IsHitTestVisibleInChrome="True">
            <Button Content="─" Width="46" Height="48"
                    Foreground="{StaticResource TextSecondaryColor}"
                    Background="Transparent" BorderThickness="0"
                    FontSize="16" Cursor="Hand"
                    Command="{Binding MinimizeCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Button x:Name="MaximizeButton" Content="□" Width="46" Height="48"
                    Foreground="{StaticResource TextSecondaryColor}"
                    Background="Transparent" BorderThickness="0"
                    FontSize="14" Cursor="Hand"
                    Command="{Binding MaximizeCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Button Content="✕" Width="46" Height="48"
                    Foreground="{StaticResource TextSecondaryColor}"
                    Background="Transparent" BorderThickness="0"
                    FontSize="16" Cursor="Hand"
                    Command="{Binding CloseCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
        </StackPanel>
    </Grid>
</UserControl>
