<UserControl x:Class="DeerFlow.WPF.Views.Pages.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Hidden"
                  HorizontalScrollBarVisibility="Hidden"
                  PanningMode="None">
        <Grid Margin="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 欢迎区域 -->
            <Border Grid.Row="0" Background="{StaticResource CardBackground}" 
                    CornerRadius="12" Padding="32" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="{Binding WelcomeMessage}" FontSize="28" 
                               FontWeight="Bold" Foreground="{StaticResource TextColor}"/>
                    <TextBlock Text="集成 AIO Sandbox 多窗口任务隔离的桌面 AI 超级助手"
                               FontSize="15" Foreground="{StaticResource TextSecondaryColor}" 
                               Margin="0,12,0,0"/>
                    <TextBlock Text="{Binding QuickStatus}" FontSize="13" 
                               Foreground="{StaticResource AccentColor}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- 快速操作区域 -->
            <Grid Grid.Row="1" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource CardBackground}"
                        CornerRadius="10" Padding="24" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="💬" FontSize="32"/>
                        <TextBlock Text="新建对话" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextColor}" Margin="0,8,0,0"/>
                        <TextBlock Text="开始与 AI 智能体对话" FontSize="12"
                                   Foreground="{StaticResource TextMutedColor}" Margin="0,4,0,12"/>
                        <Button Content="开始" Style="{StaticResource PrimaryButton}"
                                Command="{Binding NewChatCommand}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="{StaticResource CardBackground}"
                        CornerRadius="10" Padding="24" Margin="6,0,6,0">
                    <StackPanel>
                        <TextBlock Text="🚀" FontSize="32"/>
                        <TextBlock Text="新建任务" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextColor}" Margin="0,8,0,0"/>
                        <TextBlock Text="创建隔离沙箱任务窗口" FontSize="12"
                                   Foreground="{StaticResource TextMutedColor}" Margin="0,4,0,12"/>
                        <Button Content="创建" Style="{StaticResource PrimaryButton}"
                                Command="{Binding NewTaskCommand}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="{StaticResource CardBackground}"
                        CornerRadius="10" Padding="24" Margin="12,0,0,0">
                    <StackPanel>
                        <TextBlock Text="🛠" FontSize="32"/>
                        <TextBlock Text="技能商店" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextColor}" Margin="0,8,0,0"/>
                        <TextBlock Text="浏览和安装社区技能" FontSize="12"
                                   Foreground="{StaticResource TextMutedColor}" Margin="0,4,0,12"/>
                        <Button Content="浏览" Style="{StaticResource PrimaryButton}"
                                Command="{Binding OpenSkillsCommand}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 核心特性 -->
            <Border Grid.Row="2" Background="{StaticResource CardBackground}"
                    CornerRadius="12" Padding="28" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="🚀 核心特性" FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource TextColor}" Margin="0,0,0,16"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Padding="8">
                            <StackPanel>
                                <TextBlock Text="🔒" FontSize="24"/>
                                <TextBlock Text="多窗口隔离" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextColor}" Margin="0,4,0,0"/>
                                <TextBlock Text="每个任务独立沙箱进程运行" FontSize="12"
                                           Foreground="{StaticResource TextMutedColor}"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Padding="8">
                            <StackPanel>
                                <TextBlock Text="🤖" FontSize="24"/>
                                <TextBlock Text="智能体编排" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextColor}" Margin="0,4,0,0"/>
                                <TextBlock Text="子智能体协同工作流" FontSize="12"
                                           Foreground="{StaticResource TextMutedColor}"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Padding="8">
                            <StackPanel>
                                <TextBlock Text="🧠" FontSize="24"/>
                                <TextBlock Text="长期记忆" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextColor}" Margin="0,4,0,0"/>
                                <TextBlock Text="用户偏好和上下文积累" FontSize="12"
                                           Foreground="{StaticResource TextMutedColor}"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="3" Padding="8">
                            <StackPanel>
                                <TextBlock Text="💻" FontSize="24"/>
                                <TextBlock Text="本地推理" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextColor}" Margin="0,4,0,0"/>
                                <TextBlock Text="隐私优先离线也能用" FontSize="12"
                                           Foreground="{StaticResource TextMutedColor}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 最近任务 -->
            <Border Grid.Row="3" Background="{StaticResource CardBackground}"
                    CornerRadius="12" Padding="24">
                <StackPanel>
                    <TextBlock Text="最近任务" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource TextColor}" Margin="0,0,0,12"/>
                    <ItemsControl ItemsSource="{Binding RecentTasks}"
                                  VirtualizingStackPanel.IsVirtualizing="True">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource ContentBackground}"
                                        CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Name}" FontSize="14"
                                                       Foreground="{StaticResource TextColor}"/>
                                            <TextBlock Text="{Binding Description}" FontSize="12"
                                                       Foreground="{StaticResource TextMutedColor}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" CornerRadius="4" Padding="8,4"
                                                VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Running">
                                                            <Setter Property="Background" Value="#1A3A2A"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                            <Setter Property="Background" Value="#1A2A3A"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Status}" FontSize="11"
                                                       Foreground="{StaticResource SuccessColor}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
