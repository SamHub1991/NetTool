<UserControl x:Class="DeerFlow.WPF.Views.Pages.SkillsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:DeerFlow.WPF.Models">

    <Grid Background="{StaticResource ContentBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource BackgroundColor}"
                BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1"
                Padding="20,14">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🛠 技能商店" FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource TextColor}" VerticalAlignment="Center"/>
                <Button Content="刷新" Style="{StaticResource SecondaryButton}"
                        Margin="16,0,0,0"
                        Command="{Binding RefreshSkillsCommand}"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Skills}" Margin="16">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:SkillItem}">
                        <Border Background="{StaticResource CardBackground}"
                                CornerRadius="12" Padding="24"
                                Width="280" Margin="4,4,4,8">
                            <StackPanel>
                                <Border Width="48" Height="48" CornerRadius="12"
                                        Background="{StaticResource AccentColor}">
                                    <TextBlock Text="🛠" FontSize="24"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold"
                                           Foreground="{StaticResource TextColor}" Margin="0,12,0,0"/>
                                <TextBlock Text="{Binding Description}" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryColor}"
                                           TextWrapping="Wrap" Margin="0,6,0,12"/>

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="v" FontSize="10"
                                               Foreground="{StaticResource TextMutedColor}"/>
                                    <TextBlock Text="{Binding Version}" FontSize="10"
                                               Foreground="{StaticResource TextMutedColor}" Margin="2,0,0,0"/>
                                </StackPanel>

                                <Button Margin="0,12,0,0" Height="36" FontSize="13"
                                        Command="{Binding DataContext.InstallSkillCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                                    <Setter Property="Content" Value="✓ 已安装"/>
                                                    <Setter Property="IsEnabled" Value="False"/>
                                                    <Setter Property="Background" Value="{StaticResource CardBackground}"/>
                                                    <Setter Property="Foreground" Value="{StaticResource SuccessColor}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                                                    <Setter Property="Content" Value="⬇ 安装"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
