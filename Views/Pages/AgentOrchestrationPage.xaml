<UserControl x:Class="DeerFlow.WPF.Views.Pages.AgentOrchestrationPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource ContentBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 页面标题栏 -->
        <Border Grid.Row="0" Background="{StaticResource BackgroundColor}"
                BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1"
                Padding="24,16">
            <TextBlock Text="&#x1F916; 智能体编排" FontSize="18" FontWeight="SemiBold"
                       Foreground="{StaticResource TextColor}"/>
        </Border>

        <!-- 可滚动内容区 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 编排配置卡片 -->
                <Border Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0"
                        Background="{StaticResource CardBackground}"
                        CornerRadius="12" Padding="28" Margin="0,0,12,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 卡片标题 -->
                        <TextBlock Grid.Row="0" Text="编排配置" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource TextColor}" Margin="0,0,0,20"/>

                        <!-- 编排名称 -->
                        <TextBlock Grid.Row="1" Text="编排名称" FontSize="13"
                                   Foreground="{StaticResource TextSecondaryColor}" Margin="0,0,0,8"/>
                        <TextBox Grid.Row="2" Text="{Binding WorkflowName}" Height="42" FontSize="14"
                                 Margin="0,0,0,20"/>

                        <!-- 编排步骤描述 -->
                        <TextBlock Grid.Row="3" Text="编排步骤描述" FontSize="13"
                                   Foreground="{StaticResource TextSecondaryColor}" Margin="0,0,0,8"/>
                        <TextBox Grid.Row="4" Text="{Binding WorkflowSteps}" Height="100"
                                 TextWrapping="Wrap" AcceptsReturn="True"
                                 FontSize="14" Margin="0,0,0,20"/>

                        <!-- 最大子智能体数 -->
                        <TextBlock Grid.Row="5" Text="最大子智能体数" FontSize="13"
                                   Foreground="{StaticResource TextSecondaryColor}" Margin="0,0,0,8"/>
                        <Grid Grid.Row="6" Margin="0,0,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{StaticResource ContentBackground}"
                                    BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                                    CornerRadius="8" Padding="4" Width="120">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="-" Width="32" Height="32"
                                            Style="{StaticResource SecondaryButton}"
                                            FontSize="16" FontWeight="Bold"
                                            Padding="0"
                                            Command="{Binding DecreaseMaxSubAgentsCommand}"/>
                                    <TextBox Grid.Column="1" Text="{Binding MaxSubAgents, Mode=TwoWay}"
                                             Background="Transparent" BorderThickness="0"
                                             FontSize="16" FontWeight="SemiBold"
                                             Foreground="{StaticResource TextColor}"
                                             HorizontalContentAlignment="Center"
                                             VerticalContentAlignment="Center"
                                             Padding="4,0"/>
                                    <Button Grid.Column="2" Content="+" Width="32" Height="32"
                                            Style="{StaticResource SecondaryButton}"
                                            FontSize="16" FontWeight="Bold"
                                            Padding="0"
                                            Command="{Binding IncreaseMaxSubAgentsCommand}"/>
                                </Grid>
                            </Border>
                            <TextBlock Grid.Column="1" Text="建议设置 2-5 个，根据任务复杂度调整"
                                       FontSize="12" Foreground="{StaticResource TextMutedColor}"
                                       VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </Grid>

                        <!-- 操作按钮 -->
                        <StackPanel Grid.Row="7" Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="&#x1F4BE; 保存编排" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding CreateWorkflowCommand}" Margin="0,0,12,0"
                                    Padding="24,12"/>
                            <Button Content="&#x25B6; 启动执行" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding StartWorkflowCommand}"
                                    Padding="24,12"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 中间件链配置卡片 -->
                <Border Grid.Column="2" Grid.Row="0"
                        Background="{StaticResource CardBackground}"
                        CornerRadius="12" Padding="28" Margin="12,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="中间件链配置" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource TextColor}" Margin="0,0,0,12"/>

                        <TextBlock Grid.Row="1" Text="借鉴 DeerFlow 2.0 的 17 个中间件体系"
                                   FontSize="13" Foreground="{StaticResource TextSecondaryColor}"
                                   Margin="0,0,0,20" TextWrapping="Wrap"/>

                        <TextBlock Grid.Row="2" Text="已启用中间件" FontSize="12"
                                   Foreground="{StaticResource TextMutedColor}"
                                   Margin="0,0,0,12"/>

                        <WrapPanel Grid.Row="3">
                            <Border Background="{StaticResource ContentBackground}"
                                    BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                                    CornerRadius="8" Padding="12,8" Margin="0,0,8,8">
                                <TextBlock Text="&#x1F512; 线程数据" FontSize="13"
                                           Foreground="{StaticResource TextSecondaryColor}"/>
                            </Border>
                            <Border Background="{StaticResource ContentBackground}"
                                    BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                                    CornerRadius="8" Padding="12,8" Margin="0,0,8,8">
                                <TextBlock Text="&#x1F4C1; 文件上传" FontSize="13"
                                           Foreground="{StaticResource TextSecondaryColor}"/>
                            </Border>
                            <Border Background="{StaticResource ContentBackground}"
                                    BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                                    CornerRadius="8" Padding="12,8" Margin="0,0,8,8">
                                <TextBlock Text="&#x1F6E1; 工具护栏" FontSize="13"
                                           Foreground="{StaticResource TextSecondaryColor}"/>
                            </Border>
                            <Border Background="{StaticResource ContentBackground}"
                                    BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                                    CornerRadius="8" Padding="12,8" Margin="0,0,8,8">
                                <TextBlock Text="&#x1F9E0; 记忆集成" FontSize="13"
                                           Foreground="{StaticResource TextSecondaryColor}"/>
                            </Border>
                            <Border Background="{StaticResource ContentBackground}"
                                    BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                                    CornerRadius="8" Padding="12,8" Margin="0,0,8,8">
                                <TextBlock Text="&#x1F504; 循环检测" FontSize="13"
                                           Foreground="{StaticResource TextSecondaryColor}"/>
                            </Border>
                            <Border Background="{StaticResource ContentBackground}"
                                    BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                                    CornerRadius="8" Padding="12,8" Margin="0,0,8,8">
                                <TextBlock Text="&#x1F4DD; 标题生成" FontSize="13"
                                           Foreground="{StaticResource TextSecondaryColor}"/>
                            </Border>
                        </WrapPanel>
                    </Grid>
                </Border>

                <!-- 编排状态概览卡片 -->
                <Border Grid.Column="0" Grid.Row="1"
                        Background="{StaticResource CardBackground}"
                        CornerRadius="12" Padding="28" Margin="0,24,12,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="编排状态" FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource TextColor}" Margin="0,0,0,16"/>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <TextBlock Text="0" FontSize="32" FontWeight="Bold"
                                           Foreground="{StaticResource AccentColor}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="已保存编排" FontSize="12"
                                           Foreground="{StaticResource TextMutedColor}"
                                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                <TextBlock Text="0" FontSize="32" FontWeight="Bold"
                                           Foreground="{StaticResource SuccessColor}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="运行中" FontSize="12"
                                           Foreground="{StaticResource TextMutedColor}"
                                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <TextBlock Text="0" FontSize="32" FontWeight="Bold"
                                           Foreground="{StaticResource InfoColor}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="子智能体" FontSize="12"
                                           Foreground="{StaticResource TextMutedColor}"
                                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Grid.Row="2" Text="暂无运行中的编排任务"
                                   FontSize="13" Foreground="{StaticResource TextMutedColor}"
                                   HorizontalAlignment="Center" Margin="0,20,0,0"/>
                    </Grid>
                </Border>

                <!-- 快速提示卡片 -->
                <Border Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1"
                        Background="{StaticResource CardBackground}"
                        CornerRadius="12" Padding="28" Margin="12,24,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="&#x1F4A1; 使用提示" FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource TextColor}" Margin="0,0,0,16"/>

                        <StackPanel Grid.Row="1">
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse Grid.Column="0" Width="8" Height="8"
                                         Fill="{StaticResource AccentColor}" Margin="0,6,12,0"
                                         VerticalAlignment="Top"/>
                                <TextBlock Grid.Column="1" Text="编排名称应简洁明了，便于后续识别和管理"
                                           FontSize="13" Foreground="{StaticResource TextSecondaryColor}"
                                           TextWrapping="Wrap"/>
                            </Grid>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse Grid.Column="0" Width="8" Height="8"
                                         Fill="{StaticResource AccentColor}" Margin="0,6,12,0"
                                         VerticalAlignment="Top"/>
                                <TextBlock Grid.Column="1" Text="步骤描述支持多行输入，建议按序号列出各子智能体的职责"
                                           FontSize="13" Foreground="{StaticResource TextSecondaryColor}"
                                           TextWrapping="Wrap"/>
                            </Grid>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse Grid.Column="0" Width="8" Height="8"
                                         Fill="{StaticResource AccentColor}" Margin="0,6,12,0"
                                         VerticalAlignment="Top"/>
                                <TextBlock Grid.Column="1" Text="子智能体数量过多可能导致协调开销增大，建议根据实际任务复杂度调整"
                                           FontSize="13" Foreground="{StaticResource TextSecondaryColor}"
                                           TextWrapping="Wrap"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse Grid.Column="0" Width="8" Height="8"
                                         Fill="{StaticResource AccentColor}" Margin="0,6,12,0"
                                         VerticalAlignment="Top"/>
                                <TextBlock Grid.Column="1" Text="保存编排后可随时修改配置，启动执行前请确认各参数设置正确"
                                           FontSize="13" Foreground="{StaticResource TextSecondaryColor}"
                                           TextWrapping="Wrap"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
