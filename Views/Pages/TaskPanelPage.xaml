<UserControl x:Class="DeerFlow.WPF.Views.Pages.TaskPanelPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:DeerFlow.WPF.Models">

    <Grid Background="{StaticResource ContentBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <Border Grid.Row="0" Background="{StaticResource BackgroundColor}"
                BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1"
                Padding="20,14">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="📋" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="任务面板" FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource TextColor}" VerticalAlignment="Center"/>
                <TextBlock Text=" - AIO Sandbox 多窗口管理" FontSize="13"
                           Foreground="{StaticResource TextSecondaryColor}"
                           VerticalAlignment="Center" Margin="8,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- 创建任务区域 -->
        <Border Grid.Row="1" Background="{StaticResource CardBackground}"
                CornerRadius="8" Padding="20" Margin="20,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="新建沙箱任务" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextColor}"/>
                    <TextBlock Text="独立窗口+进程隔离" FontSize="11"
                               Foreground="{StaticResource TextMutedColor}" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="20,0">
                    <TextBox Text="{Binding NewTaskName}" MinHeight="36"
                             FontSize="13" Margin="0,0,0,6"
                             ToolTip="任务名称"/>
                    <TextBox Text="{Binding NewTaskDescription}" MinHeight="36"
                             FontSize="13" TextWrapping="Wrap"
                             AcceptsReturn="True" MinLines="1" MaxLines="2"
                             ToolTip="任务描述（可选）"/>
                </StackPanel>

                <Button Grid.Column="2" Content="🚀 创建任务"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding CreateTaskCommand}"
                        Padding="24,12" FontSize="14"/>
            </Grid>
        </Border>

        <!-- 任务列表 -->
        <ListBox Grid.Row="2" ItemsSource="{Binding Tasks}"
                 Background="Transparent" BorderThickness="0"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 VirtualizingStackPanel.IsVirtualizing="True"
                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                 Margin="20,0,20,20">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type models:TaskModel}">
                        <Border Background="{StaticResource CardBackground}"
                                CornerRadius="10" Padding="20"
                                Margin="0,0,0,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 状态图标 -->
                                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="8"
                                            VerticalAlignment="Top" Margin="0,0,16,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Running">
                                                        <Setter Property="Background" Value="{StaticResource SuccessColor}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                        <Setter Property="Background" Value="{StaticResource ErrorColor}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Pending">
                                                        <Setter Property="Background" Value="{StaticResource WarningColor}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="🔒" FontSize="18"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- 任务信息 -->
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold"
                                                   Foreground="{StaticResource TextColor}"/>
                                        <TextBlock Text="{Binding Description}" FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryColor}"
                                                   TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <TextBlock FontSize="11" Foreground="{StaticResource TextMutedColor}">
                                                PID: <Run Text="{Binding ProcessId}"/>
                                            </TextBlock>
                                            <TextBlock FontSize="11" Foreground="{StaticResource TextMutedColor}" Margin="16,0,0,0">
                                                内存: <Run Text="{Binding MemoryUsageMB, StringFormat=F1}"/> MB
                                            </TextBlock>
                                            <TextBlock FontSize="11" Foreground="{StaticResource TextMutedColor}" Margin="16,0,0,0">
                                                CPU: <Run Text="{Binding CpuUsagePercent, StringFormat=F1}"/>%
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- 操作按钮 -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Top" Margin="12,0,0,0">
                                        <Button Content="暂停" Style="{StaticResource SecondaryButton}"
                                                Margin="0,0,0,6"
                                                Command="{Binding DataContext.PauseTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="恢复" Style="{StaticResource SecondaryButton}"
                                                Margin="0,0,0,6"
                                                Command="{Binding DataContext.ResumeTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="关闭" Style="{StaticResource SecondaryButton}"
                                                Foreground="{StaticResource ErrorColor}"
                                                Command="{Binding DataContext.CloseTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- 进度条 -->
                                <Border Grid.Row="1" Height="4" CornerRadius="2" Margin="0,12,0,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Running">
                                                    <Setter Property="Background" Value="#1A3A2A"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                    <Setter Property="Background" Value="#3A1A1A"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Pending">
                                                    <Setter Property="Background" Value="#3A3A1A"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
