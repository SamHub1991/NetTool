<UserControl x:Class="DeerFlow.WPF.Views.Controls.StatusBarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">

    <Border Background="{StaticResource BackgroundColor}"
            BorderBrush="{StaticResource BorderColor}"
            BorderThickness="0,1,0,0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{Binding StatusMessage}"
                       Foreground="{StaticResource TextSecondaryColor}"
                       FontSize="12" VerticalAlignment="Center" Margin="16,0"/>

            <TextBlock Grid.Column="2" Text="{Binding TaskCountText}"
                       Foreground="{StaticResource TextMutedColor}"
                       FontSize="12" VerticalAlignment="Center" Margin="0,0,16,0"/>

            <TextBlock Grid.Column="3" Text="{Binding MemoryText}"
                       Foreground="{StaticResource TextMutedColor}"
                       FontSize="12" VerticalAlignment="Center" Margin="0,0,16,0"/>
        </Grid>
    </Border>
</UserControl>
