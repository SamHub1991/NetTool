<UserControl x:Class="DeerFlow.WPF.Views.Controls.PatternGraphControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <Border Background="{StaticResource CardBackground}"
            CornerRadius="12" Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 标题 -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="🕸️ 模式知识图谱" FontSize="18" FontWeight="SemiBold"
                           Foreground="{StaticResource TextColor}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="🔄 刷新" Style="{StaticResource SecondaryButton}"
                            Padding="12,6" Margin="0,0,8,0"
                            Command="{Binding RefreshGraphCommand}"/>
                    <Button Content="📊 统计" Style="{StaticResource SecondaryButton}"
                            Padding="12,6"
                            Command="{Binding ShowStatisticsCommand}"/>
                </StackPanel>
            </Grid>

            <!-- 图谱可视化区域 -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>

                <!-- 画布区域 -->
                <Border Grid.Column="0" x:Name="GraphCanvas"
                        Background="{StaticResource BackgroundColor}"
                        CornerRadius="8" BorderBrush="{StaticResource BorderColor}"
                        BorderThickness="1" MinHeight="400">
                    <Canvas x:Name="PatternCanvas">
                        <!-- 动态添加模式节点和连线 -->
                    </Canvas>
                </Border>

                <!-- 详情面板 -->
                <Border Grid.Column="1" Background="{StaticResource BackgroundColor}"
                        CornerRadius="8" BorderBrush="{StaticResource BorderColor}"
                        BorderThickness="1" Margin="12,0,0,0" Padding="16">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="📋 模式详情" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextColor}" Margin="0,0,0,12"/>
                            
                            <TextBlock x:Name="SelectedPatternName" 
                                       Text="未选择模式" FontSize="14" FontWeight="Bold"
                                       Foreground="{StaticResource TextColor}" Margin="0,0,0,8"/>
                            
                            <TextBlock x:Name="SelectedPatternCategory"
                                       Text="" FontSize="12"
                                       Foreground="{StaticResource TextMutedColor}" Margin="0,0,0,16"/>
                            
                            <TextBlock Text="描述" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextColor}" Margin="0,0,0,4"/>
                            <TextBlock x:Name="SelectedPatternDescription"
                                       Text="" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextSecondaryColor}" Margin="0,0,0,16"/>
                            
                            <TextBlock Text="使用次数" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextColor}" Margin="0,0,0,4"/>
                            <TextBlock x:Name="SelectedPatternUsage"
                                       Text="0" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryColor}" Margin="0,0,0,16"/>
                            
                            <TextBlock Text="成功率" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextColor}" Margin="0,0,0,4"/>
                            <ProgressBar x:Name="SelectedPatternSuccessRate"
                                         Height="8" Margin="0,0,0,16"
                                         Maximum="100" Minimum="0"/>
                            
                            <TextBlock Text="状态" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextColor}" Margin="0,0,0,4"/>
                            <Border x:Name="SelectedPatternStatus"
                                    Padding="8,4" CornerRadius="4"
                                    Margin="0,0,0,16">
                                <TextBlock x:Name="StatusText" FontSize="12"/>
                            </Border>

                            <Button Content="🎯 应用此模式" Style="{StaticResource PrimaryButton}"
                                    HorizontalAlignment="Stretch" Margin="0,0,0,8"
                                    Command="{Binding ApplyPatternCommand}"/>
                            <Button Content="📈 查看详情" Style="{StaticResource SecondaryButton}"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding ViewPatternDetailsCommand}"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
