<Window x:Class="DeerFlow.WPF.Views.Windows.TaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeerFlow Task Window"
        Height="600" Width="900"
        MinHeight="400" MinWidth="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundColor}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40"
                      UseAeroCaptionButtons="True"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="4"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 任务信息栏 -->
        <Border Grid.Row="0" Background="{StaticResource CardBackground}"
                Padding="16,10" BorderBrush="{StaticResource BorderColor}"
                BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🔒" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="沙箱任务" FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource TextColor}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding TaskId, StringFormat='ID: {0}'}" FontSize="11"
                           Foreground="{StaticResource TextMutedColor}"
                           VerticalAlignment="Center" Margin="12,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- 沙箱内容区 -->
        <Border Grid.Row="1" Margin="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 输出区 -->
                <Border Grid.Row="0" Background="{StaticResource ContentBackground}"
                        CornerRadius="8" Padding="16">
                    <ScrollViewer x:Name="OutputScrollViewer"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Auto"
                                  ScrollChanged="OnOutputScrollChanged">
                        <TextBox x:Name="OutputBox" 
                                 Text="{Binding OutputText, Mode=OneWay}"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource TextColor}"
                                 FontFamily="Consolas" FontSize="13"
                                 IsReadOnly="True" TextWrapping="Wrap"
                                 AcceptsReturn="True"/>
                    </ScrollViewer>
                </Border>

                <!-- 输入区 -->
                <Border Grid.Row="1" Margin="0,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0" x:Name="InputBox"
                                 Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                 Background="{StaticResource CardBackground}"
                                 Foreground="{StaticResource TextColor}"
                                 CaretBrush="{StaticResource AccentColor}"
                                 FontFamily="Consolas" FontSize="13"
                                 Padding="12,8" MinHeight="36"
                                 TextWrapping="Wrap" AcceptsReturn="True"
                                 IsEnabled="{Binding IsExecuting, Converter={StaticResource InverseBooleanConverter}}"
                                 ToolTip="输入命令，Enter 执行，Shift+Enter 换行">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding ExecuteCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>

                        <Button Grid.Column="1" Content="执行 ▶"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding ExecuteCommand}"
                                Margin="12,0,0,0" Height="36"
                                Width="80"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- 状态栏 -->
        <Border Grid.Row="2" Background="{StaticResource CardBackground}"
                Padding="16,6" BorderBrush="{StaticResource BorderColor}"
                BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding StatusText}" FontSize="11"
                           Foreground="{StaticResource TextSecondaryColor}"/>
                <TextBlock Text="{Binding SandboxPath, StringFormat='沙箱: {0}'}" FontSize="11"
                           Foreground="{StaticResource TextMutedColor}" Margin="16,0,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
