<Window x:Class="DeerFlow.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DeerFlow.WPF.Views.Controls"
        xmlns:pages="clr-namespace:DeerFlow.WPF.Views.Pages"
        xmlns:vm="clr-namespace:DeerFlow.WPF.ViewModels"
        Title="DeerFlow.WPF - AI 桌面超级智能体"
        Height="720" Width="1200"
        MinHeight="500" MinWidth="900"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True">

    <!-- WindowChrome 自定义标题栏 -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48"
                      UseAeroCaptionButtons="False"
                      GlassFrameThickness="0"
                      CornerRadius="10"
                      ResizeBorderThickness="6"/>
    </WindowChrome.WindowChrome>

    <!-- 窗口模板 - 实现圆角和阴影 -->
    <Window.Template>
        <ControlTemplate TargetType="{x:Type Window}">
            <Border x:Name="WindowBorder"
                    CornerRadius="10"
                    BorderThickness="1"
                    BorderBrush="#3A3A40"
                    Background="{StaticResource BackgroundColor}">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="0"
                                      BlurRadius="20"
                                      Color="#000000"
                                      Opacity="0.5"/>
                </Border.Effect>
                <AdornerDecorator>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="48"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="32"/>
                        </Grid.RowDefinitions>

                        <!-- 自定义标题栏 -->
                        <controls:TitleBarControl Grid.Row="0"/>

                        <!-- 主内容区 -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 侧边导航栏 -->
                            <controls:SidebarControl Grid.Column="0"/>

                            <!-- 页面内容区域 -->
                            <Border Grid.Column="1"
                                    Background="{StaticResource ContentBackground}">
                                <ContentControl Content="{Binding CurrentPage}">
                                    <ContentControl.Resources>
                                        <DataTemplate DataType="{x:Type vm:HomeViewModel}">
                                            <pages:HomePage/>
                                        </DataTemplate>
                                        <DataTemplate DataType="{x:Type vm:ChatViewModel}">
                                            <pages:ChatPage/>
                                        </DataTemplate>
                                        <DataTemplate DataType="{x:Type vm:TaskPanelViewModel}">
                                            <pages:TaskPanelPage/>
                                        </DataTemplate>
                                        <DataTemplate DataType="{x:Type vm:AgentOrchestrationViewModel}">
                                            <pages:AgentOrchestrationPage/>
                                        </DataTemplate>
                                        <DataTemplate DataType="{x:Type vm:MemoryViewModel}">
                                            <pages:MemoryPage/>
                                        </DataTemplate>
                                        <DataTemplate DataType="{x:Type vm:SkillsViewModel}">
                                            <pages:SkillsPage/>
                                        </DataTemplate>
                                        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                                            <pages:SettingsPage/>
                                        </DataTemplate>
                                        <DataTemplate DataType="{x:Type vm:IMSettingsViewModel}">
                                            <pages:IMSettingsPage/>
                                        </DataTemplate>
                                    </ContentControl.Resources>
                                </ContentControl>
                            </Border>
                        </Grid>

                        <!-- 状态栏 -->
                        <controls:StatusBarControl Grid.Row="2"/>
                    </Grid>
                </AdornerDecorator>
            </Border>

            <ControlTemplate.Triggers>
                <Trigger Property="WindowState" Value="Maximized">
                    <Setter TargetName="WindowBorder" Property="CornerRadius" Value="0"/>
                    <Setter TargetName="WindowBorder" Property="Margin" Value="8"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </Window.Template>

</Window>
