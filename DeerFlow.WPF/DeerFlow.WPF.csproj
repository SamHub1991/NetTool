<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DeerFlow.WPF</RootNamespace>
    <AssemblyName>DeerFlow.WPF</AssemblyName>
    <StartupObject>DeerFlow.WPF.App</StartupObject>
    <Version>1.0.0</Version>
    <Authors>DeerFlow.WPF Team</Authors>
    <Description>AI桌面超级智能体 - 基于WPF的智能体编排桌面应用</Description>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.122" />
    <PackageReference Include="Microsoft.SemanticKernel" Version="1.52.0" />
    <PackageReference Include="Microsoft.SemanticKernel.Connectors.OpenAI" Version="1.52.0" />
    <PackageReference Include="Alibaba.OpenSandbox" Version="0.1.0" />
    <PackageReference Include="Alibaba.OpenSandbox.CodeInterpreter" Version="0.1.0" />
    <PackageReference Include="Serilog" Version="3.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />
    <PackageReference Include="Serilog.Sinks.Debug" Version="2.0.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.0" />
    <PackageReference Include="xunit" Version="2.7.0" />
    <PackageReference Include="Moq" Version="4.20.70" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.7" />
  </ItemGroup>

  <!-- 确保只有 App.xaml 作为 ApplicationDefinition -->
  <ItemGroup>
    <ApplicationDefinition Remove="**/*.xaml" />
    <ApplicationDefinition Include="App.xaml" />
  </ItemGroup>

</Project>
