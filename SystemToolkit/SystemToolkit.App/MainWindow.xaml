<Window x:Class="SystemToolkit.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="系统工具箱 - SystemToolkit" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <!-- 左侧导航菜单 -->
        <Border Grid.Column="0" Background="#2D2D30" Margin="0,0,10,0" CornerRadius="8,0,0,8">
            <DockPanel>
                <!-- 标题 -->
                <Border DockPanel.Dock="Top" Background="#007ACC" CornerRadius="8,0,0,0" Padding="15,20">
                    <StackPanel>
                        <TextBlock Text="SystemToolkit" FontSize="20" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="系统工具箱" FontSize="12" Foreground="#CCCCCC" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
                
                <!-- 菜单列表 -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TreeView x:Name="MenuTreeView" BorderThickness="0" Background="Transparent"
                              SelectedItemChanged="MenuTreeView_SelectedItemChanged">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Margin="5,5">
                                    <TextBlock Text="{Binding Name}" FontSize="14" Foreground="#CCCCCC" VerticalAlignment="Center"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </ScrollViewer>
                
                <!-- 底部信息 -->
                <Border DockPanel.Dock="Bottom" Background="#252526" Padding="15,10">
                    <StackPanel>
                        <TextBlock Text="Version 1.0.0" FontSize="11" Foreground="#888888"/>
                        <TextBlock Text="Powered by MonkeyCode" FontSize="10" Foreground="#666666" Margin="0,3,0,0"/>
                        <TextBlock Text="https://monkeycode-ai.com" FontSize="10" Foreground="#0099CC" 
                                   MouseDown="WebsiteLink_MouseDown" Cursor="Hand" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>
        
        <!-- 右侧内容区域 -->
        <Border Grid.Column="1" Background="White" CornerRadius="8" Margin="0,0,0,0">
            <ContentControl x:Name="MainContent" Margin="20"/>
        </Border>
    </Grid>
</Window>
